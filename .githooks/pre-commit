#!/usr/bin/env bash
# Git Pre-commit Secret Scanner Hook
set -euo pipefail

SECRET_PATTERN='(sk-[A-Za-z0-9]{20,}|AKIA[A-Z0-9]{16}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{20,}|AIza[A-Za-z0-9_-]{30,}|xox[baprs]-[A-Za-z0-9-]{10,}|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'

STAGED_DIFF=$(git diff --cached --unified=0)
if echo "$STAGED_DIFF" | grep -nE "$SECRET_PATTERN" > /dev/null 2>&1; then
    echo "❌ [SECURITY ALERT] Potential secret/token detected in staged commit!"
    echo "$STAGED_DIFF" | grep -nE "$SECRET_PATTERN"
    echo "Commit aborted. Remove secret or store in ignored environment variables."
    exit 1
fi
exit 0
